# ---------------------------------------------------------------------------
# General-purpose .gitignore
# The stack for this project is not finalized yet. Trim the sections that
# don't apply (or replace this file wholesale) once the language/framework
# is chosen.
# ---------------------------------------------------------------------------

# --- Secrets & local environment ---
.env
.env.*
!.env.example
*.local
secrets.*
*.pem
*.key
credentials.json

# --- Editors / IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/

# --- OS cruft ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
.directory
.Trash-*

# --- Logs & temp files ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
tmp/
temp/

# --- Build output & dependencies (generic) ---
node_modules/
bower_components/
vendor/
dist/
build/
out/
target/
bin/
obj/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.turbo/
coverage/
*.tsbuildinfo

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
*.egg-info/
.eggs/
htmlcov/
.coverage
.coverage.*

# --- Compiled / native artifacts ---
*.o
*.obj
*.a
*.lib
*.dll
*.dylib
*.exe
*.out
*.class
*.jar

# --- Databases & archives (local scratch) ---
*.sqlite
*.sqlite3
*.db

# --- Infrastructure state ---
.terraform/
*.tfstate
*.tfstate.*

# --- Claude Code local overrides (shared config stays tracked) ---
.claude/settings.local.json
